# Optional: copy to .env.acceptance for checking the team-held test passwords.
# Keep this local file private. No password reset is performed by the check.
DEMO_PASSWORD_HEALTH_WORKER=
DEMO_PASSWORD_MEDICAL_OFFICER=
DEMO_PASSWORD_SPECIALIST=
DEMO_PASSWORD_NAVIGATOR=
DEMO_PASSWORD_DISTRICT_ADMIN=

# Only needed for authenticated acceptance of an already-enrolled MFA account.
# These are fresh six-digit codes, not authenticator setup secrets. Clear them
# after the run; they expire quickly. Never paste them into chat or a test report.
HOSTED_TOTP_CODE_MEDICAL_OFFICER=
HOSTED_TOTP_CODE_SPECIALIST=
HOSTED_TOTP_CODE_DISTRICT_ADMIN=
