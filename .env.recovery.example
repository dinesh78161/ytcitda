# Copy to .env.recovery. Never commit the configured file.
# A separate, private passphrase with at least 16 characters. Keep a recovery copy
# with the team owner, separately from the encrypted archives.
BACKUP_PASSPHRASE=

# Optional: Supabase account management token (NOT the project service API key).
# Optional owner token for additive migrations through the Management API.
SUPABASE_ACCESS_TOKEN=

# Required only for the real hosted restore rehearsal. Use a NEW isolated project,
# never the existing demo. Export/dump follows the official Supabase runbook.
RESTORE_SUPABASE_URL=
RESTORE_SUPABASE_PUBLISHABLE_KEY=
RESTORE_SUPABASE_SECRET_KEY=
