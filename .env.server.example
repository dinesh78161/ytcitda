# Copy to .env.server. Keep this file's values empty until you configure services.
# Never use a VITE_ prefix for server secrets.
API_HOST=127.0.0.1
API_PORT=8787
APP_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4173
# Render: APP_ORIGINS=https://aarogyadrishti.in,https://www.aarogyadrishti.in
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional: Daily private rooms and appointment-scoped meeting tokens.
# Recommended no-card demo option: LiveKit Cloud Build plan.
# Set VIDEO_PROVIDER=livekit after adding all three LiveKit values.
VIDEO_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Existing Daily integration remains available with VIDEO_PROVIDER=daily.
DAILY_API_KEY=

# Optional: your trained model service, with a pinned model version.
# local runs the bundled oral model on this Node server, without an external API.
# mock works without a model account. research requires all three model values.
# disabled demonstrates service failure while clinician review remains available.
# gemini uses Google's image API and needs no trained custom model.
SCREENING_AI_MODE=mock
WORKSPACE_MODE=evaluation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SCREENING_MODEL_URL=
SCREENING_MODEL_KEY=
SCREENING_MODEL_VERSION=
# Production startup also offers an explicitly labelled bundled-model action
# alongside the configured evaluation provider. Set false to disable that action.
BUNDLED_ORAL_MODEL_ENABLED=true

# Real-record assistance: use only a provider/model whose clinical use and
# validation cover your intended workflow. Gemini Developer API is excluded.
# WORKSPACE_MODE=clinical and SCREENING_AI_MODE=clinical select this separate path.
CLINICAL_AI_URL=
CLINICAL_AI_KEY=
CLINICAL_AI_MODEL_VERSION=

# Optional: explicit delivery opt-in. See docs/INTEGRATIONS.md for the webhook contract.
REMINDER_DELIVERY_ENABLED=false
REMINDER_WEBHOOK_URL=
REMINDER_WEBHOOK_KEY=
