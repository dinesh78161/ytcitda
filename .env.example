# Copy this file to .env; Vite does not load .env.example.
# Clinical workspaces require Supabase; select demo explicitly for local training.
VITE_APP_MODE=supabase
VITE_WORKSPACE_MODE=evaluation
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server integration settings belong in .env.server; see .env.server.example.
# Never put a Supabase secret/service-role key in this file or any VITE_ variable.
