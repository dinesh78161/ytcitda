# Copy this file to .env; Vite does not load .env.example.
# Use demo until your Supabase project is configured, then set supabase.
VITE_APP_MODE=demo
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server integration settings belong in .env.server; see .env.server.example.
# Never put a Supabase secret/service-role key in this file or any VITE_ variable.
