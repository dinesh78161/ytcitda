{
  "name": "aarogya-drishti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env.server server/index.mjs",
    "dev:all": "node scripts/dev.mjs",
    "ai:check": "node --env-file-if-exists=.env.server scripts/check-gemini.mjs",
    "ai:check:clinical": "node --env-file-if-exists=.env.server scripts/check-clinical-ai.mjs",
    "db:check": "node --env-file-if-exists=.env.server scripts/check-db.mjs",
    "db:prepare": "node scripts/prepare-db.mjs",
    "build": "tsc --noEmit && vite build",
    "build:render": "node --env-file-if-exists=.env.server scripts/build-render.mjs",
    "prebuild:render": "npm test",
    "start": "node --env-file-if-exists=.env.server server/start.mjs",
    "preview": "vite preview",
    "test": "node tests/offline.test.mjs && node tests/i18n.test.mjs && node tests/patient-report.test.mjs && node tests/clinical-workspace.test.mjs && node tests/database.test.mjs && node tests/workflow.test.mjs && node tests/care.test.mjs && node tests/journey.test.mjs && node tests/services.test.mjs && node tests/clinical-ai.test.mjs && node tests/clinical-ai-ui.test.mjs && node tests/oral-observation-ui.test.mjs && node tests/oral-model.test.mjs && node tests/provider.test.mjs && node tests/uploads.test.mjs && node tests/production.test.mjs && node tests/security.test.mjs && node tests/backup.test.mjs && node tests/medgemma-quality.test.mjs && node tests/clinical-samples.test.mjs",
    "test:patient-report": "node tests/patient-report.test.mjs",
    "test:deployed": "node scripts/check-deployment.mjs",
    "test:hosted": "node --env-file-if-exists=.env.server --env-file-if-exists=.env.acceptance scripts/check-hosted.mjs",
    "test:hosted:browser": "node --env-file-if-exists=.env.server --env-file-if-exists=.env.acceptance node_modules/@playwright/test/cli.js test --config playwright.hosted.config.ts",
    "test:e2e": "playwright test",
    "test:video": "playwright test --config playwright.video.config.ts",
    "test:production": "playwright test --config playwright.production.config.ts",
    "format": "prettier --write src tests server scripts *.ts *.json docs README.md",
    "backup:seal": "node --env-file-if-exists=.env.recovery scripts/protect-backup.mjs seal",
    "backup:verify": "node --env-file-if-exists=.env.recovery scripts/protect-backup.mjs verify",
    "backup:extract": "node --env-file-if-exists=.env.recovery scripts/protect-backup.mjs extract",
    "test:passwords": "node --env-file-if-exists=.env.server --env-file-if-exists=.env.acceptance scripts/check-passwords.mjs",
    "db:security": "node --env-file-if-exists=.env.server --env-file-if-exists=.env.recovery scripts/apply-security.mjs",
    "test:security:browser": "playwright test --config playwright.security.config.ts",
    "test:hosted:mfa": "node --env-file-if-exists=.env.server scripts/check-hosted-mfa.mjs",
    "ai:check:local": "node scripts/check-oral-model.mjs",
    "test:offline": "node tests/offline.test.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-kannada": "5.3.0",
    "@fontsource/noto-sans-malayalam": "5.3.0",
    "@fontsource/noto-sans-oriya": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@fontsource/noto-sans-telugu": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "idb": "8.0.4",
    "jpeg-js": "0.4.4",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "lucide-react": "1.61.0",
    "onnxruntime-node": "1.31.1",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
